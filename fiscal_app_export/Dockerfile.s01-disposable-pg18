# S01: disposable PG18 + Flask smoke in one isolated one-shot container.
# No Railway persistent volume. Unix socket only; no public HTTP server.
# Never point DATABASE_URL to any Railway PostgreSQL or use customer files.
FROM postgres:18.6-trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/s01-qa-venv
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN /opt/s01-qa-venv/bin/python -m pip install --no-cache-dir -r /app/requirements.txt
COPY . /app
USER postgres
ENTRYPOINT ["/opt/s01-qa-venv/bin/python", "/app/qa_s01_disposable_pg18.py"]

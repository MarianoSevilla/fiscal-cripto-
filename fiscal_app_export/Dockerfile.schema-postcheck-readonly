# S01 lab parking image AFTER successful schema bootstrap.
# Strictly READ ONLY. No schema writer, ORM, Alembic, app or providers.
FROM postgres:18.6-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY schema_preflight.py /app/schema_preflight.py
COPY schema_postcheck_readonly.py /app/schema_postcheck_readonly.py
USER postgres
ENTRYPOINT ["python3", "/app/schema_postcheck_readonly.py"]

# STG-B10R: NEVER deploy this image without separately approved source change.
# It is a testable final-shape image but main() always exits NO-GO.
FROM postgres:18.6-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/s01-restore-venv \
 && /opt/s01-restore-venv/bin/pip install --no-cache-dir boto3==1.40.59
WORKDIR /app
COPY probe.py /app/probe.py
COPY restore_candidate.py /app/restore_candidate.py
COPY real_restore_entrypoint.py /app/real_restore_entrypoint.py
USER postgres
ENTRYPOINT ["/opt/s01-restore-venv/bin/python", "/app/real_restore_entrypoint.py"]

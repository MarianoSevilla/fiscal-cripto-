# STG-B10S: REAL-CAPABLE BUT NOT DEPLOYED. Requires manual Railway
# S01_RECOVERY_WRITE_APPROVAL variable exact match and explicitly approved SHA.
# The CURRENT deployed service uses Dockerfile.readonly-archive, NOT THIS FILE.
FROM postgres:18.6-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/s01-restore-venv \
 && /opt/s01-restore-venv/bin/pip install --no-cache-dir boto3==1.40.59
WORKDIR /app
COPY probe.py /app/probe.py
COPY restore_candidate.py /app/restore_candidate.py
COPY execute_one_restore.py /app/execute_one_restore.py
USER postgres
ENTRYPOINT ["/opt/s01-restore-venv/bin/python", "/app/execute_one_restore.py"]

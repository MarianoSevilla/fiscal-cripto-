# STG-B10P: local candidate IMAGE ONLY. Not an authorized live runtime.
# Existing Railway service remains bound to Dockerfile (READ ONLY).
FROM postgres:18.6-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/s01-restore-venv \
 && /opt/s01-restore-venv/bin/pip install --no-cache-dir boto3==1.40.59
WORKDIR /app
COPY probe.py /app/probe.py
COPY restore_candidate.py /app/restore_candidate.py
COPY release_gate.py /app/release_gate.py
USER postgres
# The guard ALWAYS aborts, before any S3 or PostgreSQL interaction.
ENTRYPOINT ["/opt/s01-restore-venv/bin/python", "/app/release_gate.py"]

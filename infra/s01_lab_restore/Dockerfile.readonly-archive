# STG-B10Q: private READ ONLY S3 archive and target PostgreSQL verification
FROM postgres:18.6-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/s01-preflight-venv \
 && /opt/s01-preflight-venv/bin/pip install --no-cache-dir boto3==1.40.59
WORKDIR /app
COPY probe.py /app/probe.py
COPY preflight_archive.py /app/preflight_archive.py
USER postgres
ENTRYPOINT ["/opt/s01-preflight-venv/bin/python", "/app/preflight_archive.py"]
